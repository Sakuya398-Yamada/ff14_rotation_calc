{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ff14-rotation-calc",
	"main": "./src/server/index.ts",
	"compatibility_date": "2026-10-13",
	"assets": {
		"not_found_handling": "single-page-application",
		// SPA モードではブラウザの遷移リクエストが index.html に回るため、API は Worker を先に通す
		"run_worker_first": ["/api/*"]
	},
	// PR のブランチで Workers Builds が実行する `wrangler preview` は、このブロックが無いと失敗する
	"previews": {},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ff14-rotation-calc",
			// TODO(#475): `npx wrangler d1 create ff14-rotation-calc` で作った本番 D1 の ID に差し替える（マージ前に必須）
			"database_id": "00000000-0000-0000-0000-000000000000",
			// drizzle-kit の出力先（drizzle.config.ts の out）。meta/ は wrangler が読まない
			"migrations_dir": "migrations"
		}
	]
}
