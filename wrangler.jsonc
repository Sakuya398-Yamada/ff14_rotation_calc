{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ff14-rotation-calc",
	"main": "./src/server/index.ts",
	"compatibility_date": "2026-10-13",
	"assets": {
		"not_found_handling": "single-page-application",
		// SPA モードではブラウザの遷移リクエストが index.html に回るため、API は Worker を先に通す
		"run_worker_first": ["/api/*"]
	},
	// PR のブランチで Workers Builds が実行する `wrangler preview` は、このブロックが無いと失敗する。
	// プレビューは本番の設定を引き継がず、ここに書いたバインディングだけが付く
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				// 全 PR で共有するプレビュー用の D1。マイグレーションは wrangler.preview-migrations.jsonc で当てる（同じ ID に揃える）
				"database_name": "ff14-rotation-calc-preview",
				"database_id": "e91d42e7-1d5f-45cc-868f-ffe4a309211a"
			}
		],
		// namespace_id を本番と分け、プレビューの通信を本番のカウンタに数えない
		"ratelimits": [
			{
				"name": "TIMELINE_RATE_LIMITER",
				"namespace_id": "581",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ff14-rotation-calc",
			"database_id": "145a8aa1-4f2f-4340-a3ed-10ff9378b088",
			// drizzle-kit の出力先（drizzle.config.ts の out）。meta/ は wrangler が読まない
			"migrations_dir": "migrations"
		}
	],
	// 保存 API のレート制限（キーは owner_hash）。namespace_id はアカウント内で一意になるよう自分で決める正の整数で、事前の作成は要らない
	"ratelimits": [
		{
			"name": "TIMELINE_RATE_LIMITER",
			"namespace_id": "476",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
