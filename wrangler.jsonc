{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ff14-rotation-calc",
	"main": "./src/server/index.ts",
	"compatibility_date": "2026-10-13",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// SPA モードではブラウザの遷移リクエストが index.html に回るため、API は Worker を先に通す。
		// /en/ 配下も、フォールバックが日本語の index.html になるので、Worker から英語の HTML を返す（src/server/index.ts）。
		// 共有 URL の /t/ 配下は、検索結果から外す X-Robots-Tag を付けるために Worker を通す（#837）
		"run_worker_first": ["/api/*", "/en/*", "/t/*"]
	},
	// Discord のログインのクライアント ID（公開値。secret の DISCORD_CLIENT_SECRET と、ユーザー ID を HMAC にする鍵の DISCORD_ID_HMAC_KEY は wrangler secret put で入れる）。
	// プレビューには付かないので、プレビューではログインの API が 404 になる（リダイレクト URI を完全一致でしか登録できないため。#876・#892）
	"vars": { "DISCORD_CLIENT_ID": "1567231992804941844" },
	// PR のブランチで Workers Builds が実行する `wrangler preview` は、このブロックが無いと失敗する。
	// プレビューは本番の設定を引き継がず、ここに書いたバインディングだけが付く
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				// 全 PR で共有するプレビュー用の D1。マイグレーションは wrangler.preview-migrations.jsonc で当てる（同じ ID に揃える）
				"database_name": "ff14-rotation-calc-preview",
				"database_id": "e91d42e7-1d5f-45cc-868f-ffe4a309211a"
			}
		],
		// プレビューのビルドには VITE_TURNSTILE_SITE_KEY が渡らず、フロントはテスト用の sitekey（必ず成功）で動く。
		// それと対になる公開のテスト用 secret を置く（本番の secret は wrangler secret put のまま。#581）
		"vars": { "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA" },
		// namespace_id を本番と分け、プレビューの通信を本番のカウンタに数えない
		"ratelimits": [
			{
				"name": "TIMELINE_RATE_LIMITER",
				"namespace_id": "581",
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ff14-rotation-calc",
			"database_id": "145a8aa1-4f2f-4340-a3ed-10ff9378b088",
			// drizzle-kit の出力先（drizzle.config.ts の out）。meta/ は wrangler が読まない
			"migrations_dir": "migrations"
		}
	],
	// Workers Logs（ダッシュボードの Observability タブ）。書かないと wrangler deploy が { enabled: false } を送り、
	// ダッシュボードで有効にしても次のデプロイで無効に戻る（#976）。呼び出しごとの記録（URL・IP・位置・CPU 時間）を残す。
	// Cookie の値と URL の中の長い ID は Cloudflare が REDACTED にし、クエリ文字列は redact_query_string で消す。
	// referer の中の ID は伏せられないので、共有 URL のページは Referrer-Policy でパスを送らせない（src/server/index.ts）。
	// 残す記録と期間はプライバシーポリシー（src/client/components/PrivacyPolicyPage.tsx）に書いているので、変えたらそちらも直す
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": { "invocation_logs": true }
	},
	// ログアウトせずに期限が切れたセッションの行を 1 日 1 回消す（src/server/index.ts の scheduled。#919）。時刻は UTC で、19:00 は JST の 04:00。
	// D1 のバックアップ（JST 04:30。docs/d1-backup.md）より前に消し、エクスポート中に D1 が止まる時間とも重ねない。
	// Cron Trigger は本番だけに付き、プレビューでは動かない。ローカルでも自動では動かないので、npm run dev 中に /cdn-cgi/local/scheduled を開いて呼ぶ
	"triggers": { "crons": ["0 19 * * *"] },
	// 保存 API のレート制限（キーは owner_hash）。namespace_id はアカウント内で一意になるよう自分で決める正の整数で、事前の作成は要らない
	"ratelimits": [
		{
			"name": "TIMELINE_RATE_LIMITER",
			"namespace_id": "476",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
